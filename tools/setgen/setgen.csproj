<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>setgen</AssemblyName>
    <RootNamespace>HKSK.SetGen</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HKSK/HKSK.csproj" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.51.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The masters' records, read the way SKAssets reads them for a library caller. -->
    <Compile Include="../shared/MasterRecords.cs" Link="MasterRecords.cs" />
  </ItemGroup>

</Project>
